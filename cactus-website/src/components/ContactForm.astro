---
interface Props {
    variant?: 'standard' | 'urgency';
    lang: string;
}

const { variant = 'standard', lang } = Astro.props;
const isUrgency = variant === 'urgency';

const standardOptions = [
    'ERP & Gestion d\'entreprise',
    'Migration de données',
    'Cybersécurité',
    'Infrastructure & Cloud',
    'Développement sur mesure',
    'Nos Produits — Catalogue',
    'IoT & Connectivité',
    'Audit & Diagnostic IT',
    'Accompagnement sectoriel',
    'Urgence IT',
    'Autre',
];

const urgencyOptions = [
    'ERP bloqué / inaccessible',
    'Incident cybersécurité / intrusion',
    'Panne serveur critique',
    'Perte de données',
    'Migration échouée',
    'Autre urgence',
];

const options = isUrgency ? urgencyOptions : standardOptions;
// Follow the website's form chart (use light classes for both standard and urgency)
const inputClass = 'form-input';
const labelClass = 'form-label';
---

<form id={isUrgency ? 'urgency-form' : 'contact-form'}
      class="space-y-5"
      action={isUrgency ? '/api/urgence.php' : '/api/contact.php'}
      method="POST">

    <input type="hidden" name="source_url" id="contact-source-url" value="" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
            <label class={labelClass} for="nom">Nom complet *</label>
            <input type="text" id="nom" name="nom" required placeholder="Ex: M. Karim Benjelloun"
                   class={inputClass} />
            {isUrgency && <span class="text-[10px] text-ink-muted mt-1 block">Votre nom pour la prise de contact direct</span>}
        </div>
        <div>
            <label class={labelClass} for="entreprise">Entreprise *</label>
            <input type="text" id="entreprise" name="entreprise" required placeholder="Ex: SOREC S.A."
                   class={inputClass} />
            {isUrgency && <span class="text-[10px] text-ink-muted mt-1 block">Raison sociale de la société impactée</span>}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {!isUrgency && (
            <div>
                <label class={labelClass} for="email">Email professionnel *</label>
                <input type="email" id="email" name="email" required placeholder="email@entreprise.ma"
                       class={inputClass} />
            </div>
        )}
        <div>
            <label class={labelClass} for="telephone">Téléphone direct *</label>
            <input type="tel" id="telephone" name="telephone" required placeholder="Ex: +212 6 61 12 34 56"
                   class={inputClass} />
            {isUrgency && <span class="text-[10px] text-ink-muted mt-1 block">Rappel immédiat sous 2 heures ouvrées</span>}
        </div>
        {isUrgency && (
            <div>
                <label class={labelClass} for="email">Adresse Email *</label>
                <input type="email" id="email" name="email" required placeholder="email@entreprise.ma"
                       class={inputClass} />
                <span class="text-[10px] text-ink-muted mt-1 block">Pour l'envoi du rapport d'intervention</span>
            </div>
        )}
    </div>

    <div>
        <label class={labelClass} for="besoin">
            {isUrgency ? 'Type d\'urgence technique *' : 'Besoin *'}
        </label>
        <select id="besoin" name="besoin" required
                class={`${inputClass} cursor-pointer`}>
            <option value="">{isUrgency ? "— Sélectionnez le type d'incident —" : "— Sélectionnez votre besoin —"}</option>
            {options.map(opt => (
                <option value={opt}>{opt}</option>
            ))}
        </select>
        {isUrgency && <span class="text-[10px] text-ink-muted mt-1 block">Sélectionnez la catégorie qui décrit le mieux la panne</span>}
    </div>

    <div>
        <label class={labelClass} for="message">
            {isUrgency ? 'Description détaillée de la situation *' : 'Message *'}
        </label>
        <textarea id="message" name="message" required rows="4"
                  placeholder={isUrgency ? 'Décrivez la panne ou l\'incident (Ex: Base de données SQL corrompue suite à panne de disque, ERP inaccessible depuis 8h...)' : 'Décrivez votre besoin en quelques lignes...'}
                  class={inputClass}></textarea>
        {isUrgency && <span class="text-[10px] text-ink-muted mt-1 block">Détaillez les messages d'erreur ou les symptômes visibles</span>}
    </div>

    <div>
        <label class={labelClass} for="attachment">
            Pièce jointe (optionnel)
        </label>
        <div id="attachment-dropzone"
             class="relative flex items-center gap-3 p-3.5 border border-ink/10 rounded-xl bg-cloud/40 hover:bg-cloud/70 transition-all cursor-pointer group">
            <input type="file" id="attachment" name="attachment"
                   accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.zip,.rar,.txt,.csv,.xlsx"
                   class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
            <div id="attachment-icon-container"
                 class="p-2.5 rounded-lg bg-cactus-green/10 text-cactus-green group-hover:scale-105 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
            </div>
            <div class="flex-1 text-sm overflow-hidden">
                <div id="attachment-label" class="font-medium text-ink truncate">Joindre un fichier (PDF, image, document, archive...)</div>
                <div id="attachment-sublabel" class="text-xs text-ink-muted">Taille maximale : 10 Mo</div>
            </div>
            <button type="button" id="attachment-remove-btn"
                    class="hidden z-20 p-1.5 rounded-lg text-earth-brown hover:bg-earth-brown/10 transition-colors"
                    title="Supprimer la pièce jointe">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                </svg>
            </button>
        </div>
        {isUrgency ? (
            <span class="text-[10px] text-ink-muted mt-1 block">Joignez une capture d'erreur, un fichier de log ou une pièce justificative (max 10 Mo)</span>
        ) : (
            <span class="text-[10px] text-ink-muted mt-1 block">Formats acceptés : PDF, images, Word, ZIP, TXT (max 10 Mo)</span>
        )}
    </div>

    <!-- Honeypot field (hidden from human users, visible to bots) -->
    <div class="hidden" aria-hidden="true">
        <label class="form-label" for="fax">Fax</label>
        <input type="text" id="fax" name="fax" tabindex="-1" autocomplete="off" class="form-input" />
    </div>

    <!-- Feedback Container -->
    <div id="form-feedback" class="hidden rounded-xl p-4 text-sm font-medium transition-all duration-300"></div>

    <button type="submit"
            class={`magnetic-btn w-full md:w-auto inline-flex items-center justify-center gap-2.5 font-heading font-bold text-sm rounded-full px-8 py-4.5 text-white transition-all hover:-translate-y-0.5 hover:shadow-xl cursor-pointer`}
            style={`background: var(--color-${isUrgency ? 'earth-brown' : 'cactus-green'});`}>
        {isUrgency ? (
            <>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
                    <path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
                Déclencher l'alerte d'urgence IT
            </>
        ) : (
            <>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
                </svg>
                Envoyer le message
            </>
        )}
    </button>

    <p class="text-xs mt-3" style={`color: var(--color-ink-muted);`}>
        {isUrgency ? 'Un ingénieur senior prend contact avec vous sous 2h. Facturation au résultat.' : 'Nous vous répondons sous 24 heures ouvrées.'}
    </p>
</form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const select = document.getElementById('besoin') as HTMLSelectElement | null;
        if (select) {
            const params = new URLSearchParams(window.location.search);
            const besoinParam = params.get('besoin');
            
            if (besoinParam) {
                const mapping: Record<string, string> = {
                    'erp': "ERP & Gestion d'entreprise",
                    'migration': "Migration de données",
                    'cybersecurite': "Cybersécurité",
                    'infrastructure': "Infrastructure & Cloud",
                    'developpement': "Développement sur mesure",
                    'produits': "Nos Produits — Catalogue",
                    'iot': "IoT & Connectivité",
                    'audit': "Audit & Diagnostic IT",
                    'secteur': "Accompagnement sectoriel",
                    'urgence': "Urgence IT"
                };
                
                const targetVal = mapping[besoinParam.toLowerCase()];
                if (targetVal) {
                    for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value === targetVal) {
                            select.selectedIndex = i;
                            break;
                        }
                    }
                }
            }
        }

        const sourceInput = document.getElementById('contact-source-url') as HTMLInputElement | null;
        if (sourceInput) {
            sourceInput.value = document.referrer || window.location.href;
        }

        const form = (document.getElementById('contact-form') || document.getElementById('urgency-form')) as HTMLFormElement | null;
        if (form) {
            const attachmentInput = form.querySelector('#attachment') as HTMLInputElement | null;
            const attachmentLabel = form.querySelector('#attachment-label') as HTMLDivElement | null;
            const attachmentSublabel = form.querySelector('#attachment-sublabel') as HTMLDivElement | null;
            const attachmentRemoveBtn = form.querySelector('#attachment-remove-btn') as HTMLButtonElement | null;
            const attachmentDropzone = form.querySelector('#attachment-dropzone') as HTMLDivElement | null;
            const attachmentIconContainer = form.querySelector('#attachment-icon-container') as HTMLDivElement | null;

            const resetAttachmentUI = () => {
                if (attachmentInput) attachmentInput.value = '';
                if (attachmentLabel) attachmentLabel.innerText = "Joindre un fichier (PDF, image, document, archive...)";
                if (attachmentSublabel) attachmentSublabel.innerText = "Taille maximale : 10 Mo";
                if (attachmentRemoveBtn) attachmentRemoveBtn.classList.add('hidden');
                if (attachmentDropzone) {
                    attachmentDropzone.classList.remove('border-cactus-green', 'bg-cactus-green/5');
                    attachmentDropzone.classList.add('border-ink/10', 'bg-cloud/40');
                }
                if (attachmentIconContainer) {
                    attachmentIconContainer.classList.remove('bg-cactus-green', 'text-white');
                    attachmentIconContainer.classList.add('bg-cactus-green/10', 'text-cactus-green');
                }
            };

            if (attachmentInput) {
                attachmentInput.addEventListener('change', () => {
                    const file = attachmentInput.files?.[0];
                    if (!file) {
                        resetAttachmentUI();
                        return;
                    }

                    const maxBytes = 10 * 1024 * 1024; // 10MB
                    if (file.size > maxBytes) {
                        alert("Le fichier sélectionné dépasse la taille maximale de 10 Mo.");
                        resetAttachmentUI();
                        return;
                    }

                    const sizeFormatted = file.size > 1024 * 1024
                        ? (file.size / (1024 * 1024)).toFixed(2) + ' Mo'
                        : Math.round(file.size / 1024) + ' Ko';

                    if (attachmentLabel) attachmentLabel.innerText = file.name;
                    if (attachmentSublabel) attachmentSublabel.innerText = `Fichier prêt (${sizeFormatted})`;
                    if (attachmentRemoveBtn) attachmentRemoveBtn.classList.remove('hidden');

                    if (attachmentDropzone) {
                        attachmentDropzone.classList.remove('border-ink/10', 'bg-cloud/40');
                        attachmentDropzone.classList.add('border-cactus-green', 'bg-cactus-green/5');
                    }
                    if (attachmentIconContainer) {
                        attachmentIconContainer.classList.remove('bg-cactus-green/10', 'text-cactus-green');
                        attachmentIconContainer.classList.add('bg-cactus-green', 'text-white');
                    }
                });
            }

            if (attachmentRemoveBtn) {
                attachmentRemoveBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    resetAttachmentUI();
                });
            }

            form.addEventListener('submit', async (e: Event) => {
                e.preventDefault();

                const nameInput = form.querySelector('#nom') as HTMLInputElement | null;
                const companyInput = form.querySelector('#entreprise') as HTMLInputElement | null;
                const emailInput = form.querySelector('#email') as HTMLInputElement | null;
                const phoneInput = form.querySelector('#telephone') as HTMLInputElement | null;
                const serviceSelect = form.querySelector('#besoin') as HTMLSelectElement | null;
                const messageInput = form.querySelector('#message') as HTMLTextAreaElement | null;
                const feedbackDiv = form.querySelector('#form-feedback') as HTMLDivElement | null;
                const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
                const honeypotInput = form.querySelector('#fax') as HTMLInputElement | null;

                const showFeedback = (msg: string, type: 'success' | 'error') => {
                    if (!feedbackDiv) return;
                    feedbackDiv.innerText = msg;
                    feedbackDiv.classList.remove('hidden');
                    if (type === 'success') {
                        feedbackDiv.style.background = 'rgba(71, 106, 51, 0.08)';
                        feedbackDiv.style.color = 'var(--color-cactus-green)';
                        feedbackDiv.style.border = '1px solid rgba(71, 106, 51, 0.2)';
                    } else {
                        feedbackDiv.style.background = 'rgba(111, 50, 3, 0.08)';
                        feedbackDiv.style.color = 'var(--color-earth-brown)';
                        feedbackDiv.style.border = '1px solid rgba(111, 50, 3, 0.2)';
                    }
                };

                // Clear previous feedback
                if (feedbackDiv) {
                    feedbackDiv.classList.add('hidden');
                    feedbackDiv.innerText = '';
                }

                const name = nameInput?.value.trim() || '';
                const email = emailInput?.value.trim() || '';
                const message = messageInput?.value.trim() || '';
                const company = companyInput?.value.trim() || '';
                const phone = phoneInput?.value.trim() || '';
                const service = serviceSelect?.value || '';
                const fax = honeypotInput?.value || '';

                // If honeypot is filled, treat as bot submission. Reject and return fake success.
                if (fax) {
                    console.warn('Bot submission blocked.');
                    showFeedback("Votre message a été envoyé avec succès. Merci !", 'success');
                    form.reset();
                    resetAttachmentUI();
                    const sourceInput = form.querySelector('#contact-source-url') as HTMLInputElement | null;
                    if (sourceInput) {
                        sourceInput.value = document.referrer || window.location.href;
                    }
                    return;
                }

                // Validation checks
                if (!name) {
                    showFeedback("Veuillez renseigner votre nom complet.", 'error');
                    return;
                }
                if (name.length > 255) {
                    showFeedback("Le nom complet ne peut pas dépasser 255 caractères.", 'error');
                    return;
                }

                if (!email) {
                    showFeedback("Veuillez renseigner votre adresse email.", 'error');
                    return;
                }
                if (email.length > 255) {
                    showFeedback("L'adresse email ne peut pas dépasser 255 caractères.", 'error');
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    showFeedback("Veuillez saisir une adresse email valide.", 'error');
                    return;
                }

                if (!message) {
                    showFeedback("Veuillez saisir votre message.", 'error');
                    return;
                }
                if (message.length > 4000) {
                    showFeedback("Le message ne peut pas dépasser 4000 caractères.", 'error');
                    return;
                }

                if (company && company.length > 255) {
                    showFeedback("Le nom de l'entreprise ne peut pas dépasser 255 caractères.", 'error');
                    return;
                }

                if (phone && phone.length > 50) {
                    showFeedback("Le numéro de téléphone ne peut pas dépasser 50 caractères.", 'error');
                    return;
                }

                if (!service) {
                    showFeedback("Veuillez sélectionner un besoin.", 'error');
                    return;
                }
                if (service.length > 100) {
                    showFeedback("Le service sélectionné est invalide.", 'error');
                    return;
                }

                // Attachment processing
                let attachmentInfo: { name: string; type: string; base64: string; sizeFormatted: string } | null = null;
                const file = attachmentInput?.files?.[0];

                if (file) {
                    const maxBytes = 10 * 1024 * 1024; // 10MB
                    if (file.size > maxBytes) {
                        showFeedback("Le fichier joint dépasse la taille maximale autorisée (10 Mo).", 'error');
                        return;
                    }

                    const sizeFormatted = file.size > 1024 * 1024
                        ? (file.size / (1024 * 1024)).toFixed(2) + ' Mo'
                        : Math.round(file.size / 1024) + ' Ko';

                    try {
                        const base64Data = await new Promise<string>((resolve, reject) => {
                            const reader = new FileReader();
                            reader.onload = () => resolve(reader.result as string);
                            reader.onerror = () => reject(new Error("Erreur de lecture du fichier"));
                            reader.readAsDataURL(file);
                        });

                        attachmentInfo = {
                            name: file.name,
                            type: file.type || 'application/octet-stream',
                            base64: base64Data,
                            sizeFormatted
                        };
                    } catch (err) {
                        showFeedback("Impossible de lire le fichier joint. Veuillez réessayer.", 'error');
                        return;
                    }
                }

                // API request payload preparation
                const isUrgencyForm = form.id === 'urgency-form';
                const subject = isUrgencyForm ? "Signalement d'urgence" : "Demande de contact";

                let fullMessage = message;
                if (attachmentInfo) {
                    fullMessage += `\n\n[Pièce jointe : ${attachmentInfo.name} (${attachmentInfo.sizeFormatted})]`;
                }

                const payload: Record<string, any> = {
                    name,
                    company,
                    email,
                    phone,
                    subject,
                    service,
                    message: fullMessage,
                    sourceWebsite: window.location.href,
                    fax
                };

                if (attachmentInfo && file) {
                    const rawBase64 = attachmentInfo.base64.includes(',')
                        ? attachmentInfo.base64.split(',')[1]
                        : attachmentInfo.base64;

                    payload.attachmentName = attachmentInfo.name;
                    payload.attachmentType = attachmentInfo.type;
                    payload.attachmentBase64 = attachmentInfo.base64;

                    payload.attachments = [
                        {
                            name: attachmentInfo.name,
                            fileName: attachmentInfo.name,
                            type: attachmentInfo.type,
                            contentType: attachmentInfo.type,
                            data: attachmentInfo.base64,
                            content: rawBase64,
                            base64: attachmentInfo.base64,
                            size: file.size
                        }
                    ];
                }

                // Disable inputs
                const inputs = Array.from(form.elements) as (HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement)[];
                inputs.forEach(input => {
                    input.disabled = true;
                });

                // Show loading state on button
                const originalBtnContent = submitBtn?.innerHTML || '';
                if (submitBtn) {
                    submitBtn.innerHTML = `
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Envoi en cours...
                    `;
                }

                try {
                    const response = await fetch('https://nerobel.nexenflow.com/api/public/contact', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-API-Key': 'nexenflow_integration_key'
                        },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        const ticketNum = data.ticketNumber || data.ticket_number || data.ticketId || data.ticketNo;
                        if (ticketNum && feedbackDiv) {
                            feedbackDiv.innerHTML = `
                                <div class="space-y-2 text-left">
                                    <p class="font-bold text-base text-cactus-green">Votre message a été envoyé avec succès !</p>
                                    <p class="text-sm text-ink">Votre numéro de ticket de suivi FlowOps :</p>
                                    <div class="inline-flex items-center gap-2 bg-cactus-dark text-white font-mono font-bold text-sm px-3.5 py-2 rounded-lg shadow-sm border border-gold/30">
                                        <span class="text-gold">N° Ticket :</span>
                                        <span class="text-white text-base tracking-wider font-extrabold select-all">${ticketNum}</span>
                                    </div>
                                    <p class="text-xs text-ink/70">Conservez ce numéro pour le suivi de votre demande.</p>
                                </div>
                            `;
                            feedbackDiv.classList.remove('hidden');
                            feedbackDiv.style.background = 'rgba(71, 106, 51, 0.08)';
                            feedbackDiv.style.color = 'var(--color-cactus-green)';
                            feedbackDiv.style.border = '1px solid rgba(71, 106, 51, 0.2)';
                        } else {
                            showFeedback("Votre message a été envoyé avec succès. Merci !", 'success');
                        }
                        form.reset();
                        resetAttachmentUI();
                        // Restore referral URL input value
                        const sourceInput = form.querySelector('#contact-source-url') as HTMLInputElement | null;
                        if (sourceInput) {
                            sourceInput.value = document.referrer || window.location.href;
                        }
                    } else {
                        console.error('API Error:', response.status, data);
                        showFeedback(data?.message || "Une erreur est survenue lors de l'envoi. Veuillez réessayer.", 'error');
                    }
                } catch (err) {
                    console.error('Network Error:', err);
                    showFeedback("Erreur de connexion. Veuillez vérifier votre réseau et réessayer.", 'error');
                } finally {
                    // Re-enable elements
                    inputs.forEach(input => {
                        input.disabled = false;
                    });
                    if (submitBtn) {
                        submitBtn.innerHTML = originalBtnContent;
                    }
                }
            });
        }
    });
</script>
