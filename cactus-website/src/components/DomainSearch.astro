---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="domain-search-container max-w-4xl mx-auto w-full bg-white rounded-3xl shadow-xl overflow-hidden border border-cloud">
  <!-- Search Header -->
  <div class="bg-cactus-dark p-8 md:p-12 text-center relative overflow-hidden">
    <!-- Background accents -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-gold rounded-full mix-blend-overlay blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-cactus-green rounded-full mix-blend-overlay blur-3xl"></div>
    </div>
    
    <h2 class="text-3xl md:text-4xl font-outfit font-bold text-white mb-4 relative z-10">
      Trouvez votre nom de domaine .ma
    </h2>
    <p class="text-white/80 mb-8 max-w-2xl mx-auto relative z-10">
      L'extension officielle du Maroc. Vérifiez la disponibilité et réservez votre identité numérique dès aujourd'hui.
    </p>

    <div class="relative z-10 max-w-2xl mx-auto flex flex-col sm:flex-row gap-3">
      <div class="relative flex-grow">
        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink/40"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <input 
          type="text" 
          id="domain-input" 
          placeholder="votre-entreprise" 
          class="w-full pl-12 pr-16 py-4 rounded-xl border-2 border-transparent bg-white text-ink placeholder-ink/40 focus:border-gold focus:ring-4 focus:ring-gold/20 hover:border-cloud-dark transition-all duration-300 outline-none text-lg"
        >
        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
          <span class="text-lg font-bold text-ink/80 domain-ext">.ma</span>
        </div>
      </div>
      <button 
        id="search-btn"
        class="bg-gold hover:bg-gold/90 text-ink font-semibold py-4 px-8 rounded-xl transition-all duration-300 flex items-center justify-center gap-2"
      >
        <span>Vérifier</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="search-loading" class="hidden p-12 text-center">
    <div class="animate-spin w-12 h-12 border-4 border-cloud border-t-cactus-green rounded-full mx-auto mb-4"></div>
    <p class="text-ink/70 font-medium">Recherche dans la base de données de l'ANRT...</p>
  </div>

  <!-- Result State (Available) & Form -->
  <div id="registration-flow" class="hidden p-8 md:p-12">
    <div class="bg-cloud/50 border border-cactus-green/20 rounded-2xl p-6 mb-8 flex items-center justify-between flex-wrap gap-4">
      <div>
        <h3 class="text-xl font-bold text-ink flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cactus-green"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Félicitations !
        </h3>
        <p class="text-ink/70"><span id="result-domain-name" class="font-semibold text-cactus-green text-lg"></span> est disponible.</p>
      </div>
      <div class="text-right">
        <p class="text-2xl font-bold text-ink">150 Dhs <span class="text-sm font-normal text-ink/60">H.T. / an</span></p>
      </div>
    </div>

    <form id="domain-form" class="space-y-8">
      <input type="hidden" name="domain_name" id="hidden-domain-name">
      
      <!-- Honeypot field (hidden from humans, visible to bots) -->
      <div class="hidden" aria-hidden="true">
        <input type="text" id="fax" name="fax" tabindex="-1" autocomplete="off" />
      </div>
      
      <!-- Applicant Type -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold text-ink border-b border-cloud pb-2">Type de titulaire</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="relative flex cursor-pointer rounded-xl border border-cloud bg-white p-4 shadow-sm focus-within:border-cactus-green focus-within:ring-1 focus-within:ring-cactus-green hover:border-cactus-green/50 transition-colors">
            <input type="radio" name="applicant_type" value="personal" class="sr-only applicant-radio" checked>
            <div class="flex flex-col">
              <span class="block text-sm font-medium text-ink">Particulier</span>
              <span class="block text-sm text-ink/60">Pour votre usage personnel (ex: blog, portfolio).</span>
            </div>
            <div class="radio-indicator absolute right-4 top-4 h-5 w-5 rounded-full border border-cloud flex items-center justify-center">
              <div class="inner-dot h-2.5 w-2.5 rounded-full bg-cactus-green hidden"></div>
            </div>
          </label>

          <label class="relative flex cursor-pointer rounded-xl border border-cloud bg-white p-4 shadow-sm focus-within:border-cactus-green focus-within:ring-1 focus-within:ring-cactus-green hover:border-cactus-green/50 transition-colors">
            <input type="radio" name="applicant_type" value="business" class="sr-only applicant-radio">
            <div class="flex flex-col">
              <span class="block text-sm font-medium text-ink">Entreprise / Organisation</span>
              <span class="block text-sm text-ink/60">Pour une société, association ou marque déposée.</span>
            </div>
            <div class="radio-indicator absolute right-4 top-4 h-5 w-5 rounded-full border border-cloud flex items-center justify-center">
              <div class="inner-dot h-2.5 w-2.5 rounded-full bg-cactus-green hidden"></div>
            </div>
          </label>
        </div>
      </div>

      <!-- General Info -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="first_name" class="block text-sm font-medium text-ink mb-1">Prénom *</label>
          <input type="text" id="first_name" name="first_name" required class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
        </div>
        <div>
          <label for="last_name" class="block text-sm font-medium text-ink mb-1">Nom *</label>
          <input type="text" id="last_name" name="last_name" required class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-ink mb-1">Adresse Email *</label>
          <input type="email" id="email" name="email" required class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-ink mb-1">Téléphone *</label>
          <input type="tel" id="phone" name="phone" required class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
        </div>
      </div>

      <!-- Dynamic Fields (Personal vs Business) -->
      <div id="personal-fields" class="space-y-4">
        <h4 class="text-lg font-bold text-ink border-b border-cloud pb-2">Informations d'Identité (Particulier)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="cin" class="block text-sm font-medium text-ink mb-1">Numéro de CIN *</label>
            <input type="text" id="cin" name="cin" class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
            <p class="text-xs text-ink/60 mt-1">Requis par l'ANRT pour valider le titulaire du domaine.</p>
          </div>
          <div>
            <label for="cin_doc" class="block text-sm font-medium text-ink mb-1">Copie de la CIN (Recto-Verso PDF / Image)</label>
            <input type="file" id="cin_doc" name="cin_doc" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-xs text-ink/70 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-cactus-green/10 file:text-cactus-green hover:file:bg-cactus-green/20 cursor-pointer border border-cloud rounded-lg p-1.5 bg-white">
            <p class="text-xs text-ink/60 mt-1">Justificatif d'identité ANRT (Max 5 Mo — PDF, JPG, PNG).</p>
          </div>
        </div>
      </div>

      <div id="business-fields" class="space-y-4 hidden">
        <h4 class="text-lg font-bold text-ink border-b border-cloud pb-2">Informations de l'Entreprise</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="company_name" class="block text-sm font-medium text-ink mb-1">Raison Sociale *</label>
            <input type="text" id="company_name" name="company_name" class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
          </div>
          <div>
            <label for="ice" class="block text-sm font-medium text-ink mb-1">ICE (Identifiant Commun de l'Entreprise) *</label>
            <input type="text" id="ice" name="ice" class="w-full rounded-lg border border-cloud px-4 py-3 focus:border-cactus-green focus:ring-1 focus:ring-cactus-green outline-none transition-colors">
          </div>
        </div>
        <div>
          <label for="business_doc" class="block text-sm font-medium text-ink mb-1">Justificatif d'Entreprise (Registre de Commerce / Attestation ICE PDF ou Image)</label>
          <input type="file" id="business_doc" name="business_doc" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-xs text-ink/70 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-cactus-green/10 file:text-cactus-green hover:file:bg-cactus-green/20 cursor-pointer border border-cloud rounded-lg p-1.5 bg-white">
          <p class="text-xs text-ink/60 mt-1">Document officiel pour validation ANRT (Max 5 Mo — PDF, JPG, PNG).</p>
        </div>
      </div>

      <!-- Addons -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold text-ink border-b border-cloud pb-2">Options</h4>
        <label class="flex items-start gap-3 cursor-pointer p-4 rounded-xl border border-cloud hover:bg-cloud/20 transition-colors">
          <div class="flex items-center h-5 mt-0.5">
            <input type="checkbox" name="protection_id" class="w-4 h-4 text-cactus-green border-cloud rounded focus:ring-cactus-green">
          </div>
          <div class="flex-grow">
            <span class="block text-sm font-medium text-ink">Protection ID (ONOFF)</span>
            <span class="block text-sm text-ink/60">Masquez vos informations personnelles dans l'annuaire WHOIS public.</span>
          </div>
          <div class="text-sm font-bold text-ink">+35 Dhs <span class="font-normal text-ink/60">/an</span></div>
        </label>
      </div>

      <!-- Nameservers -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold text-ink border-b border-cloud pb-2">Configuration DNS (Nameservers)</h4>
        <p class="text-sm text-ink/70">Les serveurs de noms (DNS) relient votre nom de domaine à votre hébergement web.</p>
        
        <div class="space-y-3 mt-4">
          <label class="flex items-center gap-3">
            <input type="radio" name="nameservers_type" value="default" class="w-4 h-4 text-cactus-green focus:ring-cactus-green ns-radio" checked>
            <span class="text-sm font-medium">Utiliser les DNS par défaut (Recommandé)</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="radio" name="nameservers_type" value="custom" class="w-4 h-4 text-cactus-green focus:ring-cactus-green ns-radio">
            <span class="text-sm font-medium">Utiliser des serveurs DNS personnalisés</span>
          </label>
        </div>

        <div id="custom-ns-fields" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 p-4 bg-cloud/30 rounded-xl">
          <div>
            <label class="block text-xs font-medium text-ink mb-1">Nameserver 1 *</label>
            <input type="text" name="ns1" placeholder="ns1.example.com" class="w-full rounded-md border border-cloud px-3 py-2 text-sm focus:border-cactus-green outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-ink mb-1">Nameserver 2 *</label>
            <input type="text" name="ns2" placeholder="ns2.example.com" class="w-full rounded-md border border-cloud px-3 py-2 text-sm focus:border-cactus-green outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-ink mb-1">Nameserver 3</label>
            <input type="text" name="ns3" class="w-full rounded-md border border-cloud px-3 py-2 text-sm focus:border-cactus-green outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-ink mb-1">Nameserver 4</label>
            <input type="text" name="ns4" class="w-full rounded-md border border-cloud px-3 py-2 text-sm focus:border-cactus-green outline-none">
          </div>
        </div>
      </div>

      <!-- Legal Agreements -->
      <div class="space-y-4 bg-cloud/20 p-5 rounded-xl border border-cloud">
        <h4 class="text-sm font-bold text-ink mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Engagements légaux
        </h4>
        <label class="flex items-start gap-3 cursor-pointer">
          <div class="flex items-center h-5 mt-0.5">
            <input type="checkbox" name="terms_accepted" required class="w-4 h-4 text-cactus-green border-cloud rounded focus:ring-cactus-green">
          </div>
          <span class="block text-sm text-ink/80">
            Conformément à la loi 09-08, j'accepte le traitement de mes données personnelles. J'ai lu et j'accepte les <a href="/fr/mentions-legales" target="_blank" class="text-cactus-green hover:underline">Conditions Générales d'Utilisation</a>.
          </span>
        </label>
        <label class="flex items-start gap-3 cursor-pointer">
          <div class="flex items-center h-5 mt-0.5">
            <input type="checkbox" name="anrt_accepted" required class="w-4 h-4 text-cactus-green border-cloud rounded focus:ring-cactus-green">
          </div>
          <span class="block text-sm text-ink/80">
            Je confirme avoir pris connaissance de la <a href="https://www.anrt.ma/sites/default/files/2024-06/decision_02-2024_-_ndd_fr_.pdf" target="_blank" class="text-cactus-green hover:underline">Décision de l'ANRT (02-2024)</a> régissant les noms de domaine .ma et je m'engage à ne pas enregistrer de termes réservés.
          </span>
        </label>
      </div>

      <!-- Error / Success Messages -->
      <div id="form-message" class="hidden p-4 rounded-xl text-sm font-medium"></div>

      <!-- Submit -->
      <div class="pt-4 text-right">
        <button type="submit" id="submit-btn" class="bg-cactus-green hover:bg-cactus-green/90 text-white font-semibold py-4 px-8 rounded-xl transition-all duration-300 inline-flex items-center justify-center gap-2">
          <span>Confirmer la commande</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  /* Custom Radio styling */
  input[type="radio"]:checked ~ .radio-indicator {
    border-color: #476A33; /* Cactus Green */
  }
  input[type="radio"]:checked ~ .radio-indicator .inner-dot {
    display: block;
  }
  label:has(input[type="radio"]:checked) {
    border-color: #476A33;
    background-color: #f8faf5;
  }
</style>

<script>
  // DOM Elements
  const domainInput = document.getElementById('domain-input') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn');
  const domainExt = document.querySelector('.domain-ext') as HTMLElement;
  const searchLoading = document.getElementById('search-loading');
  const registrationFlow = document.getElementById('registration-flow');
  const resultDomainName = document.getElementById('result-domain-name');
  const hiddenDomainName = document.getElementById('hidden-domain-name') as HTMLInputElement;
  
  // Applicant type toggle
  const applicantRadios = document.querySelectorAll('.applicant-radio');
  const personalFields = document.getElementById('personal-fields');
  const businessFields = document.getElementById('business-fields');
  const cinInput = document.getElementById('cin') as HTMLInputElement;
  const companyNameInput = document.getElementById('company_name') as HTMLInputElement;
  const iceInput = document.getElementById('ice') as HTMLInputElement;

  // NS toggle
  const nsRadios = document.querySelectorAll('.ns-radio');
  const customNsFields = document.getElementById('custom-ns-fields');

  // Form submission
  const form = document.getElementById('domain-form') as HTMLFormElement;
  const formMessage = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Check URL parameters for search term
  if (domainInput && searchBtn) {
    const urlParams = new URLSearchParams(window.location.search);
    const searchQuery = urlParams.get('search');
    if (searchQuery) {
      let val = searchQuery.replace(/\.ma$/i, '').trim();
      val = val.replace(/[^a-zA-Z0-9-]/g, '').toLowerCase();
      domainInput.value = val;
      setTimeout(() => {
        searchBtn.click();
      }, 300);
    }
  }
  if (domainInput) {
    domainInput.addEventListener('input', () => {
      // Remove any existing .ma if user types it
      let val = domainInput.value.replace(/\.ma$/i, '').trim();
      // Remove invalid chars for a domain (simplified)
      val = val.replace(/[^a-zA-Z0-9-]/g, '').toLowerCase();
      domainInput.value = val;
    });
  }

  // Simulate search
  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      const val = domainInput.value.trim();
      if (!val) {
        domainInput.focus();
        return;
      }

      const fullDomain = val + '.ma';
      
      // Hide results, show loading
      if (registrationFlow) registrationFlow.classList.add('hidden');
      if (searchLoading) searchLoading.classList.remove('hidden');

      // Simulate API call (1.5s delay)
      setTimeout(() => {
        if (searchLoading) searchLoading.classList.add('hidden');
        if (registrationFlow) registrationFlow.classList.remove('hidden');
        
        if (resultDomainName) resultDomainName.textContent = fullDomain;
        if (hiddenDomainName) hiddenDomainName.value = fullDomain;
        
        // Scroll to flow
        registrationFlow?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 1500);
    });
  }

  // Toggle Applicant fields
  applicantRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'personal') {
        personalFields?.classList.remove('hidden');
        businessFields?.classList.add('hidden');
        cinInput.required = true;
        companyNameInput.required = false;
        iceInput.required = false;
      } else {
        personalFields?.classList.add('hidden');
        businessFields?.classList.remove('hidden');
        cinInput.required = false;
        companyNameInput.required = true;
        iceInput.required = true;
      }
    });
  });

  // Toggle NS fields
  nsRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'custom') {
        customNsFields?.classList.remove('hidden');
        // Require first 2 NS
        const ns1 = document.querySelector('input[name="ns1"]') as HTMLInputElement;
        const ns2 = document.querySelector('input[name="ns2"]') as HTMLInputElement;
        if(ns1) ns1.required = true;
        if(ns2) ns2.required = true;
      } else {
        customNsFields?.classList.add('hidden');
        const ns1 = document.querySelector('input[name="ns1"]') as HTMLInputElement;
        const ns2 = document.querySelector('input[name="ns2"]') as HTMLInputElement;
        if(ns1) ns1.required = false;
        if(ns2) ns2.required = false;
      }
    });
  });

  // Handle form submit
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!formMessage) return;
      
      // Update UI
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<div class="animate-spin w-5 h-5 border-2 border-white border-t-transparent rounded-full"></div> <span>Envoi de la commande...</span>';
      formMessage.classList.add('hidden');
      formMessage.className = 'p-4 rounded-xl text-sm font-medium'; // Reset classes

      try {
        const formData = new FormData(form);
        const fax = (formData.get('fax') as string || '').trim();

        // Honeypot bot protection check
        if (fax) {
          console.warn('Bot submission blocked.');
          formMessage.classList.remove('hidden');
          formMessage.classList.add('bg-cactus-green/10', 'text-cactus-green', 'border', 'border-cactus-green/20');
          formMessage.textContent = "Votre commande a été transmise avec succès !";
          form.reset();
          return;
        }

        const firstName = (formData.get('first_name') as string || (document.getElementById('first_name') as HTMLInputElement)?.value || '').trim();
        const lastName = (formData.get('last_name') as string || (document.getElementById('last_name') as HTMLInputElement)?.value || '').trim();
        const name = `${firstName} ${lastName}`.trim();
        const email = (formData.get('email') as string || (document.getElementById('email') as HTMLInputElement)?.value || '').trim();
        const phone = (formData.get('phone') as string || (document.getElementById('phone') as HTMLInputElement)?.value || '').trim();
        const applicantType = formData.get('applicant_type') as string;
        
        const cin = (formData.get('cin') as string || (document.getElementById('cin') as HTMLInputElement)?.value || '').trim();
        const companyName = (formData.get('company_name') as string || (document.getElementById('company_name') as HTMLInputElement)?.value || '').trim();
        const ice = (formData.get('ice') as string || (document.getElementById('ice') as HTMLInputElement)?.value || '').trim();

        // Extract domain name with fallback to result text or input
        const domainName = (formData.get('domain_name') as string || formData.get('domain') as string || resultDomainName?.textContent || hiddenDomainName?.value || '').trim();
        // Helper to convert File to Base64 Data URL
        const fileToBase64 = (file: File): Promise<string> => {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve(reader.result as string);
            reader.onerror = error => reject(error);
          });
        };

        const cinFile = (form.querySelector('#cin_doc') as HTMLInputElement)?.files?.[0];
        const businessFile = (form.querySelector('#business_doc') as HTMLInputElement)?.files?.[0];
        const selectedFile = applicantType === 'personal' ? cinFile : businessFile;

        // Best Practice File Size Limit: 5 MB
        const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 MB in bytes
        if (selectedFile && selectedFile.size > MAX_FILE_SIZE) {
          const fileSizeMB = (selectedFile.size / (1024 * 1024)).toFixed(1);
          formMessage.classList.remove('hidden');
          formMessage.classList.add('bg-amber/10', 'text-earth-brown', 'border', 'border-amber/20');
          formMessage.textContent = `La pièce jointe (${fileSizeMB} Mo) dépasse la limite autorisée de 5 Mo. Veuillez sélectionner un fichier plus léger (PDF ou image compressée).`;
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
          return;
        }

        let attachmentBase64 = '';
        let attachmentName = '';

        if (selectedFile) {
          try {
            attachmentBase64 = await fileToBase64(selectedFile);
            attachmentName = selectedFile.name;
          } catch (err) {
            console.error('Error reading file attachment:', err);
          }
        }

        const cinDoc = cinFile?.name ? `Fichier CIN joint: ${cinFile.name}` : 'Aucun fichier CIN joint';
        const businessDoc = businessFile?.name ? `Fichier RC/ICE joint: ${businessFile.name}` : 'Aucun fichier d\'entreprise joint';
        const protectionId = formData.get('protection_id') ? 'Oui (+35 Dhs/an)' : 'Non';
        const nsType = formData.get('nameservers_type') as string;
        const ns1 = (formData.get('ns1') as string || '').trim();
        const ns2 = (formData.get('ns2') as string || '').trim();
        const ns3 = (formData.get('ns3') as string || '').trim();
        const ns4 = (formData.get('ns4') as string || '').trim();

        const company = applicantType === 'business' 
          ? (companyName || 'Entreprise') 
          : (cin ? `Particulier - CIN ${cin}` : 'Particulier');

        const messageLines = [
          `--- DEMANDE D'ENREGISTREMENT NOM DE DOMAINE .MA ---`,
          `Nom de Domaine : ${domainName}`,
          `Type de demandeur : ${applicantType === 'personal' ? 'Particulier' : 'Entreprise / Organisation'}`,
          `Nom complet du contact : ${name}`,
          `Email : ${email}`,
          `Téléphone : ${phone}`,
          applicantType === 'personal' 
            ? `Numéro CIN : ${cin}\nPièce d'identité : ${cinDoc}` 
            : `Raison Sociale : ${companyName}\nICE : ${ice}\nJustificatif d'entreprise : ${businessDoc}`,
          `Protection ID (Anonymat WHOIS) : ${protectionId}`,
          `Configuration DNS : ${nsType === 'custom' ? `Serveurs Personnalisés\n  - NS1: ${ns1}\n  - NS2: ${ns2}${ns3 ? `\n  - NS3: ${ns3}` : ''}${ns4 ? `\n  - NS4: ${ns4}` : ''}` : 'DNS Cactus Informatique (Par défaut)'}`,
          `Engagements ANRT & Loi 09-08 : Validés par le client.`
        ];

        const payload = {
          name,
          company,
          email,
          phone,
          subject: "Demande de contact",
          service: "Infrastructure & Cloud",
          message: messageLines.join('\n'),
          sourceWebsite: window.location.href,
          fax: ''
        };

        const res = await fetch('https://nerobel.nexenflow.com/api/public/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-API-Key': 'ca_pub_pEidrlnNqnKnR-4ScfXY1P_rf3h8lUhr'
          },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        formMessage.classList.remove('hidden');

        if (res.ok && data.success) {
          formMessage.classList.add('bg-cactus-green/10', 'text-cactus-green', 'border', 'border-cactus-green/20');
          const ticketNum = data.ticketNumber || data.ticket_number || data.ticketId || data.ticketNo;
          if (ticketNum) {
            console.log("Ticket créé avec succès :", ticketNum);
            formMessage.innerHTML = `
              <div class="p-2 space-y-2 text-left">
                <p class="font-bold text-lg text-cactus-green">Votre demande pour <span class="underline">${domainName}</span> a été enregistrée avec succès !</p>
                <p class="text-sm text-ink">Numéro de ticket de suivi FlowOps :</p>
                <div class="inline-flex items-center gap-2 bg-cactus-dark text-white font-mono font-bold text-base px-4 py-2.5 rounded-xl shadow-md border border-gold/30">
                  <span class="text-gold">N° Ticket :</span>
                  <span class="text-white text-lg tracking-wider font-extrabold select-all">${ticketNum}</span>
                </div>
                <p class="text-xs text-ink/70">Veuillez conserver ce numéro pour le suivi de votre dossier avec notre équipe support (validation sous 24h ouvrées).</p>
              </div>
            `;
          } else {
            formMessage.innerText = `Votre demande pour ${domainName} a été enregistrée avec succès ! Notre équipe la traitera dans les plus brefs délais.`;
          }
          form.reset();
          formMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          console.error('API Error:', res.status, data);
          throw new Error(data.message || "Une erreur est survenue lors de la transmission de la commande.");
        }
      } catch (error: any) {
        formMessage.classList.remove('hidden');
        formMessage.classList.add('bg-amber/10', 'text-earth-brown', 'border', 'border-amber/20');
        formMessage.textContent = error.message || "Erreur de connexion au serveur.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }
</script>
